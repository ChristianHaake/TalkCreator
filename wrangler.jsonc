{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "interviewdesigner",
  "compatibility_date": "2026-06-25",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "env": {
    "stage": {
      "routes": [
        { "pattern": "stage.talkcreator.haak3.de", "custom_domain": true }
      ]
    }
  }
}
